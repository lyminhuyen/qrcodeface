{
  "name": "qrcodeface",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pkill -f 'next dev' 2>/dev/null; rm -rf .next/dev/lock 2>/dev/null; next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "crawl:raw": "tsx scripts/crawler.ts",
    "crawl": "npm run crawl:raw && npm run data:generate && npm run data:validate",
    "crawl:all:raw": "tsx scripts/crawl-all.ts",
    "crawl:all": "npm run crawl:all:raw && npm run data:generate && npm run data:validate",
    "crawl:background:raw": "tsx scripts/crawl-background.ts",
    "crawl:background": "npm run crawl:background:raw && npm run data:generate && npm run data:validate",
    "crawl:comments:raw": "CRAWL_PROFILE=monthly tsx scripts/crawl-background.ts",
    "crawl:comments": "npm run crawl:comments:raw && npm run data:generate && npm run data:validate",
    "test:crawler": "tsx --test scripts/crawler/*.test.ts",
    "merge": "npm run data:generate",
    "merge:remote": "tsx scripts/merge-remote-qrcodes.ts",
    "data:generate": "tsx scripts/generate-qrcode-data.ts",
    "data:validate": "tsx scripts/validate-qrcode-data.ts"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "lucide-react": "^0.562.0",
    "lzma1": "^0.2.0",
    "next": "16.1.1",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "puppeteer": "^24.34.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
