# Public origin used in email redirects, without a trailing slash.
APP_URL=http://localhost:3000

# Cloudflare Turnstile. Development uses official test keys when these are omitted.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=localhost
# Only set this on Vercel Preview to use Cloudflare's official always-pass test keys.
TURNSTILE_TEST_MODE=false

# Supabase project
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
